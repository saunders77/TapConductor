{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TapConductor",
  "version": "0.1.0",
  "identifier": "com.tapconductor.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TapConductor",
        "label": "main",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "theme": "Light",
        "backgroundColor": "#e9e8df"
      }
    ],
    "security": {
      "csp": "default-src 'self' asset: http://asset.localhost; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost https://us.i.posthog.com https://eu.i.posthog.com https://api.github.com https://raw.githubusercontent.com",
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "resources": {
      "../assets/SlenderSalamander44khz16bit": "instruments/salamander",
      "../assets/demo/Prelude in C Minor - Chopin 1839.musicxml": "demo/Prelude in C Minor - Chopin 1839.musicxml",
      "../assets/demo/All-Night Vigil - Rachmaninoff 1915.musicxml": "demo/All-Night Vigil - Rachmaninoff 1915.musicxml",
      "../LICENSING.md": "LICENSING.md",
      "../PRIVACY.md": "PRIVACY.md",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "category": "Music",
    "shortDescription": "Perform written scores one tap at a time.",
    "longDescription": "TapConductor plays each rhythmically aligned note or chord in a score exactly when the performer taps.",
    "copyright": "Copyright © 2026 Michael Saunders",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "template": "installer.nsi"
      }
    }
  }
}
