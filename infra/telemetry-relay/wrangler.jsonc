{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tapconductor-telemetry-relay",
  "main": "worker.mjs",
  "compatibility_date": "2026-08-01",
  "vars": {
    "POSTHOG_HOST": "https://us.i.posthog.com",
    "ALLOWED_ORIGINS": "https://tapconductor.app,https://www.tapconductor.app,http://tauri.localhost,tauri://localhost"
  },
  "routes": [
    { "pattern": "telemetry.tapconductor.app/v1/events", "custom_domain": true }
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 }
    }
  ]
}
