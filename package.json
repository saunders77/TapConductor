{
  "name": "tapconductor",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:web": "node tools/build-web.mjs",
    "test:auto-follow": "node --experimental-strip-types --test src/auto-follow.test.ts",
    "test:beat": "node --experimental-strip-types --test src/beat-scheduler.test.ts",
    "test:incremental-render": "node --experimental-strip-types --test src/incremental-score-render.test.ts",
    "test:web-runtime": "node tools/smoke-web.mjs",
    "test:web-gate": "node --experimental-strip-types --test src/web-note-gate.test.ts",
    "test:telemetry": "node --experimental-strip-types --test src/telemetry.test.ts",
    "test:announcement": "node --experimental-strip-types --test src/announcement.test.ts",
    "test:unit": "node --experimental-strip-types --test src/*.test.ts",
    "preview": "vite preview",
    "preview:web": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "store:windows:validate": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File tools/windows-store.ps1 -ValidateOnly",
    "store:windows:test": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File tools/windows-store.ps1 -Mode TestUnsigned",
    "store:windows:production": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File tools/windows-store.ps1 -Mode Production",
    "store:windows:verify": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File tools/windows-store.ps1 -VerifyOnly",
    "apple:validate": "bash tools/apple-release.sh validate",
    "apple:mac:test": "bash tools/apple-release.sh mac-test",
    "apple:mac:release": "bash tools/apple-release.sh mac-developer-id",
    "apple:mac:store": "bash tools/apple-release.sh mac-app-store",
    "apple:ipad:simulator": "bash tools/apple-release.sh ios-simulator",
    "apple:ipad:development": "bash tools/apple-release.sh ios-development",
    "apple:ipad:store": "bash tools/apple-release.sh ios-app-store",
    "apple:ios:simulator": "bash tools/apple-release.sh ios-simulator",
    "apple:ios:development": "bash tools/apple-release.sh ios-development",
    "apple:ios:store": "bash tools/apple-release.sh ios-app-store",
    "apple:iphone:simulator": "bash tools/apple-release.sh ios-simulator",
    "apple:iphone:development": "bash tools/apple-release.sh ios-development",
    "apple:iphone:store": "bash tools/apple-release.sh ios-app-store"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "opensheetmusicdisplay": "^2.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.4",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
