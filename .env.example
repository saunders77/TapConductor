# Optional override for a staging project or fork. TapConductor's public
# production PostHog ingestion token is already compiled into the client.
VITE_POSTHOG_PROJECT_KEY=

# Prefer the first-party relay in production. If omitted, the client sends to
# PostHog's US batch endpoint directly.
VITE_TELEMETRY_ENDPOINT=https://telemetry.tapconductor.app/v1/events
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Optional release metadata. app_version always comes from package.json.
VITE_BUILD_NUMBER=
VITE_RELEASE_CHANNEL=production
